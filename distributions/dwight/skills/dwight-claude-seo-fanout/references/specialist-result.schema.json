{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wanderlabs:dwight-claude-seo:specialist-result:v1",
  "title": "Dwight Claude SEO specialist result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specialist",
    "upstream_agent",
    "status",
    "score",
    "summary",
    "findings",
    "limitations",
    "data_sources_used",
    "paid_calls",
    "production_mutations"
  ],
  "properties": {
    "specialist": {
      "type": "string",
      "minLength": 1
    },
    "upstream_agent": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked",
        "skipped"
      ]
    },
    "score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "evidence_id",
          "issue_type",
          "affected_url",
          "severity",
          "title",
          "observation",
          "impact",
          "recommendation",
          "leading_indicator",
          "falsification_test",
          "confidence",
          "sources",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "issue_type": {
            "type": "string",
            "minLength": 1
          },
          "affected_url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "leading_indicator": {
            "type": "string",
            "minLength": 1
          },
          "falsification_test": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data_sources_used": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "paid_calls": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "production_mutations": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
